#
# Install as a *user* unit:  ~/.config/systemd/user/hermes-perf.service
# (paired with hermes-perf.timer). A oneshot service; the timer will not
# start a second instance while one is still running, so polls never overlap.

[Unit]
Description=Hermes perf: poll for new builds, benchmark, publish results
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Assumes the worktrees are at ~/hermes-data/{main,data}. Adjust if your layout
# differs.
ExecStart=%h/hermes-data/main/runner/poll-and-bench.sh
# Optional: put SOURCE_REPO=, BRANCH=, REPS=, DATA_REPO_DIR= etc. here.
# Kept at the parent (outside both worktrees) so it isn't an untracked file.
EnvironmentFile=-%h/hermes-data/runner.env
# Pin to performance governor / single core could go here if desired.
Nice=-5

[Install]
WantedBy=default.target
